# Google Gemini API Configuration
# Required: Your Gemini API key for contract analysis and structured outputs
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Alternative variable name supported by Google GenAI
# GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: Default model used in src/generate.py (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
